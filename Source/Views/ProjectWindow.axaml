<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Taskeasy_Manager.Source.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="720"
        x:Class="Taskeasy_Manager.Source.Models.Controller.ProjectWindow"
        x:DataType="vm:SecoundViewModel"
        Title="Taskeasy_Manager"
        Background="#FF474747">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid Margin="0" ItemsSource="{Binding Rows}" x:Name="GridList"
            AutoGenerateColumns="False" CanUserResizeColumns="True"
            GridLinesVisibility="All" IsReadOnly="False" Background="Transparent">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Tarefa" Binding="{Binding TaskColumn}"/>
                <DataGridTextColumn Header="Importância" Binding="{Binding ImportanceColumn}"/>
                <DataGridTextColumn Header="Dia Inicial" Binding="{Binding DataColumn}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="1" Content="Criar nova tarefa" HorizontalAlignment="Right" 
            Click="CreateTask" Background="Transparent" Margin="0, 0, 0, 20"/>

        <Button Grid.Row="1" Content="Salvar" HorizontalAlignment="Right"
                Click="SaveProj"  Background="Transparent" Margin="0, 0, 150, 20"/>
    </Grid>
</Window>