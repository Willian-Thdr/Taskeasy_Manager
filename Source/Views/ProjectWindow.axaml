<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Taskeasy_Manager.Source.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="720"
        x:Class="Taskeasy_Manager.Source.Models.Controller.ProjectWindow"
        x:DataType="vm:SecondViewModel"
        Title="Taskeasy_Manager"
        Background="#FF474747"
        Icon="/Assets/Icone-oficial-1.ico">

        <Window.Styles>
            <Style Selector="Button">
                <Setter Property="Background" Value="#DABA06"/>
            </Style>


            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="#DABA06"/>
            </Style>
        </Window.Styles>
        
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.Background>
            <LinearGradientBrush StartPoint="750,750" EndPoint="50,50">
                <GradientStop Color="#FF0C69D3" Offset="0"/>
                <GradientStop Color="#FF0A1AA7" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <DataGrid Margin="0" ItemsSource="{Binding Rows}" x:Name="GridList"
            AutoGenerateColumns="False" CanUserResizeColumns="True"
            GridLinesVisibility="All" IsReadOnly="False" Background="Transparent">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Tarefa" Binding="{Binding TaskColumn}"/>
                <DataGridTextColumn Header="Importância" Binding="{Binding ImportanceColumn}"/>
                <DataGridTextColumn Header="Dia" Binding="{Binding DataColumn}"/>
                <DataGridTextColumn Header="Horário" Binding="{Binding TimeColumn}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="1" Content="Criar nova tarefa" HorizontalAlignment="Right" 
            Click="CreateTask" Background="#DABA06" Margin="0, 0, 0, 20" CornerRadius="20"
            Foreground="Black"/>

        <Button Grid.Row="1" Content="Salvar" HorizontalAlignment="Right"
                Click="SaveProj"  Background="#DABA06" Margin="0, 0, 150, 20" CornerRadius="20"
                Foreground="Black"/>

        <Button Grid.Row="1" Content="Escolher Aleatóriamente" HorizontalAlignment="Right"
                Click="Randomized"  Background="#DABA06" Margin="0, 0, 229, 20" CornerRadius="20"
                Foreground="Black"/>

        <Button Grid.Row="1" Content="Deletar" HorizontalAlignment="Right"
                Click="Delete"  Background="#DABA06" Margin="0, 0, 429, 20" CornerRadius="20"
                Foreground="Black"/>
    </Grid>
</Window>